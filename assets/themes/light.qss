QMainWindow, QWidget, QDialog {
  background-color: #f4f7f6;
  color: #1e363b;
  font-family: "Segoe UI", sans-serif;
  font-size: 13px;
}

/* Force all labels to be transparent by default unless overridden */
QLabel {
  background-color: transparent;
}

QFrame#sidebar {
  background-color: #1a3c40;
  border-right: none;
  min-width: 176px; max-width: 176px;
}

QFrame#top_bar {
  background-color: #ffffff;
  border-bottom: 1px solid #e2eef0;
  min-height: 48px; max-height: 48px;
}

QFrame#status_bar {
  background-color: #1a3c40;
  min-height: 28px; max-height: 28px;
}

QFrame#breadcrumb {
  background-color: #f1f8f9;
  border-bottom: 1px solid #e2eef0;
  min-height: 32px; max-height: 32px;
}
QLabel#breadcrumb_current {
  color: #165663;
  font-weight: 600;
  font-size: 12px;
}
QLabel#breadcrumb_sep {
  color: #94b2b8;
  font-size: 12px;
  padding: 0 2px;
}
QPushButton#breadcrumb_link {
  background: transparent;
  border: none;
  color: #64848b;
  font-size: 12px;
  padding: 2px 4px;
}
QPushButton#breadcrumb_link:hover {
  color: #165663;
  text-decoration: underline;
}

QFrame#content_area {
  background-color: #f4f7f6;
}

/* --- Typography --- */
QLabel#page_title {
  font-size: 14px;
  font-weight: 700;
  color: #64848b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

QLabel#page_subtitle {
  font-size: 20px;
  font-weight: 600;
  color: #1e363b;
  margin-bottom: 10px;
}

QLabel#page_title_main {
  font-size: 16px;
  font-weight: 700;
  color: #0e7490;
}

QLabel#admin_only_label {
  color: #94b2b8;
  font-style: italic;
}

/* --- Buttons --- */
QPushButton {
  background-color: #0e7490;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 600;
  min-height: 34px;
}
QPushButton:hover {
  background-color: #155e75;
}
QPushButton:pressed {
  background-color: #165663;
}
QPushButton:disabled {
  background-color: #e2eef0; color: #94b2b8;
}

QPushButton#btn_danger {
  background-color: #ef4444;
}
QPushButton#btn_danger:hover {
  background-color: #dc2626;
}

QPushButton#btn_success {
  background-color: #10b981;
}
QPushButton#btn_success:hover {
  background-color: #059669;
}

QPushButton#btn_warning {
  background-color: #f59e0b;
}
QPushButton#btn_warning:hover {
  background-color: #d97706;
}

QPushButton#btn_secondary {
  background-color: transparent;
  color: #0e7490;
  border: 1px solid #cbdde1;
  min-height: 34px;
}
QPushButton#btn_secondary:hover {
  background-color: #f1f8f9;
}

QPushButton#nav_btn {
  background-color: transparent; border: none;
  border-radius: 10px; color: rgba(255,255,255,0.6);
  min-width: 52px; max-width: 52px;
  min-height: 52px; max-height: 52px;
}
QPushButton#nav_btn:hover {
  background-color: rgba(255,255,255,0.1);
  color: #ffffff;
}
QPushButton#nav_btn[active="true"] {
  background-color: #0e7490;
  color: #ffffff;
  border-left: 3px solid #165663;
  border-radius: 0px 10px 10px 0px;
}

QPushButton#nav_toggle_btn {
  background-color: transparent; border: none;
  border-radius: 10px; color: #64848b;
  min-width: 52px; max-width: 52px;
  min-height: 52px; max-height: 52px;
  font-size: 18px;
}
QPushButton#nav_toggle_btn:hover {
  background-color: rgba(255,255,255,0.1);
  color: #1e363b;
}

QFrame#nav_separator {
  background-color: #e2eef0;
  max-height: 1px;
}

QPushButton#model_btn {
  background-color: #ffffff;
  color: #1e363b;
  border: 1px solid #e2eef0;
  border-radius: 12px;
  min-height: 100px;
  text-align: left;
}
QPushButton#model_btn:hover {
  background-color: #f4f7f6;
  border-color: #06B6D4;
}
QPushButton#model_btn:checked {
  background-color: #ecfeff;
  border: 1.5px solid #06B6D4;
}
QPushButton#model_btn QLabel#model_page_title {
  color: #1e363b;
  font-size: 18px; font-weight: 700;
  background: transparent; border: none;
}
QPushButton#model_btn QLabel#model_page_desc {
  color: #64848b;
  font-size: 12px;
  background: transparent; border: none;
}
QPushButton#model_btn QLabel#model_page_meta {
  color: #94b2b8;
  font-size: 11px;
  background: transparent; border: none;
}

/* --- Inputs --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: #ffffff;
  color: #1e363b;
  border: 1px solid #cbdde1;
  border-radius: 6px;
  padding: 6px 12px;
  min-height: 36px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
  border-color: #0e7490;
  background-color: #ffffff;
}

QFormLayout QLabel {
  font-weight: 500;
  color: #476369;
  min-width: 120px;
}

/* --- Tables --- */
QTableWidget {
  background-color: #ffffff;
  alternate-background-color: #f4f7f6;
  color: #1e363b;
  gridline-color: #f1f8f9;
  selection-background-color: #cffafe;
  selection-color: #0e7490;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  font-size: 12px;
}
QTableWidget::item {
  padding: 4px 8px;
}

QHeaderView::section {
  background-color: #f1f8f9;
  color: #476369;
  border: none;
  border-bottom: 1px solid #e2eef0;
  padding: 8px 10px;
  font-weight: 600;
  font-size: 12px;
  min-height: 28px;
}

/* --- Containers --- */
QGroupBox {
  color: #334f55;
  font-weight: 600;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  margin-top: 12px;
  padding-top: 20px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 5px;
}

QFrame#status_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 12px;
}

/* ParamCard Styling */
QFrame#module_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 12px;
}
QFrame#module_card[result="pass"] {
  border-color: #10b981;
  background-color: #f0fdf4;
}
QFrame#module_card[result="fail"] {
  border-color: #ef4444;
  background-color: #fef2f2;
}
QFrame#module_card[result="running"] {
  border-color: #eab308;
}

QLabel#card_group_label {
  font-size: 9px;
  font-weight: 800;
  color: #94b2b8;
  text-transform: uppercase;
}

QLabel#card_drag_handle {
  color: #cbdde1;
  font-size: 14px;
}

QLabel#card_name_label {
  font-weight: 600;
  color: #476369;
}
QFrame#module_card[size_mode="large"] QLabel#card_name_label { font-size: 14px; }
QFrame#module_card[size_mode="medium"] QLabel#card_name_label { font-size: 13px; }
QFrame#module_card[size_mode="small"] QLabel#card_name_label { font-size: 11px; }

QLabel#card_value_label {
  font-weight: 700;
  font-family: "Consolas", "Monaco", monospace;
  color: #1e363b;
}
QFrame#module_card[size_mode="large"] QLabel#card_value_label { font-size: 28px; }
QFrame#module_card[size_mode="medium"] QLabel#card_value_label { font-size: 22px; }
QFrame#module_card[size_mode="small"] QLabel#card_value_label { font-size: 18px; }

QLabel#card_unit_label {
  color: #94b2b8;
  font-weight: 500;
}
QFrame#module_card[size_mode="large"] QLabel#card_unit_label { font-size: 12px; }
QFrame#module_card[size_mode="medium"] QLabel#card_unit_label { font-size: 10px; }
QFrame#module_card[size_mode="small"] QLabel#card_unit_label { font-size: 9px; }

QFrame#warning_banner {
  background-color: #fff7ed;
  border: 1px solid #fed7aa;
  border-radius: 8px;
}
QFrame#warning_banner QLabel {
  color: #9a3412;
  font-weight: 500;
}

QLabel#plc_status_text {
  font-weight: 600;
  font-size: 14px;
}

QLabel#connection_status_label {
  font-size: 16px;
  font-weight: 700;
}

QLabel#success_message {
  color: #10b981;
  font-weight: 600;
}

QLabel#connection_test_title {
  font-size: 18px;
  font-weight: 700;
  color: #10b981;
}

/* --- Test Page Components --- */
QFrame#model_banner {
  background-color: #f1f8f9;
  border: 1px solid #e2eef0;
  border-radius: 8px;
}
QFrame#model_banner[connected="true"] {
  background-color: #f0fdf4;
  border-color: #bbf7d0;
}
QFrame#model_banner[connected="false"] {
  background-color: #fef2f2;
  border-color: #fecaca;
}

QLabel#model_banner_text {
  font-size: 16px;
  font-weight: 700;
  color: #1e363b;
}

QLabel#empty_dashboard_label {
  font-size: 14px;
  color: #64848b;
  font-style: italic;
}

QFrame#overall_result_card, QFrame#cycle_time_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 10px;
}

QLabel#small_header_label {
  font-size: 10px;
  font-weight: 800;
  color: #94b2b8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

QLabel#cycle_time_value {
  font-size: 20px;
  font-weight: 700;
  color: #0e7490;
  font-family: "Consolas", "Monaco", monospace;
}

/* Overall Status Labels */
QLabel#result_pending {
  font-size: 20px;
  font-weight: 800;
  color: #64848b;
}
QLabel#result_running {
  font-size: 20px;
  font-weight: 800;
  color: #eab308;
}
QLabel#result_pass {
  font-size: 20px;
  font-weight: 800;
  color: #10b981;
}
QLabel#result_fail {
  font-size: 20px;
  font-weight: 800;
  color: #ef4444;
}

/* Counters */
QFrame#counter_card {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  padding: 6px;
}

QFrame#summary_counters_card {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  padding: 4px;
}

QLabel[type="counter_value"] {
  font-size: 22px;
  font-weight: 700;
  color: #0e7490;
}

QLabel#counter_name_label {
  font-size: 9px;
  font-weight: 700;
  color: #64848b;
  text-transform: uppercase;
}

QLabel#no_counters_label {
  font-size: 10px;
  color: #94b2b8;
  font-style: italic;
}

/* --- Tabs --- */
QTabWidget::pane {
  border: 1px solid #e2eef0;
  border-radius: 8px;
  top: -1px;
  background-color: #ffffff;
}

QTabBar::tab {
  background-color: #f1f8f9;
  color: #64848b;
  padding: 8px 20px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  margin-right: 4px;
  font-weight: 500;
}
QTabBar::tab:selected {
  background-color: #ffffff;
  color: #0e7490;
  border: 1px solid #e2eef0;
  border-bottom-color: #ffffff;
  font-weight: 600;
}
QTabBar::tab:hover:!selected {
  background-color: #e2eef0;
}

/* --- Progress Bar --- */
QProgressBar {
  background-color: #f1f8f9;
  border: none;
  border-radius: 10px;
  height: 8px;
  text-align: center;
}
QProgressBar::chunk {
  background-color: #0e7490;
  border-radius: 10px;
}

/* ============================================
   LOGIN OVERLAY
   ============================================ */
QFrame#login_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 12px;
}
QLabel#login_title {
  font-size: 28px;
  font-weight: bold;
  color: #1e363b;
}
QLabel#login_version {
  font-size: 12px;
  color: #64848b;
}
QLabel#login_plc_notice {
  background-color: rgba(245, 158, 11, 0.1);
  color: #d97706;
  padding: 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: bold;
}
QLabel#login_form_label {
  color: #476369;
  font-weight: 600;
  font-size: 11px;
  text-transform: uppercase;
}
QLabel#login_error {
  color: #ef4444;
  font-size: 11px;
  font-weight: bold;
}
QPushButton#login_eye_btn {
  background-color: #ffffff;
  border: 1px solid #cbdde1;
  border-radius: 6px;
  font-size: 16px;
}
QPushButton#login_eye_btn:hover {
  background-color: #f1f8f9;
}

/* ============================================
   TOP BAR
   ============================================ */
QLabel#app_name_lbl {
  font-weight: bold;
  font-size: 13px;
  color: #0e7490;
}
QLabel#top_bar_title {
  font-weight: 600;
  font-size: 14px;
  color: #1e363b;
}
QLabel#plc_status_lbl {
  font-weight: 600;
  color: #d97706;
}
QLabel#plc_status_lbl[connected="true"] {
  color: #059669;
}
QLabel#plc_status_lbl[connected="false"] {
  color: #dc2626;
}
QLabel#quality_lbl {
  font-family: "Consolas", "Monaco", monospace;
  color: #64848b;
}
QLabel#cycle_lbl {
  font-family: "Consolas", "Monaco", monospace;
  color: #64848b;
}
QLabel#user_lbl {
  font-weight: bold;
  color: #1e363b;
}
QLabel#clock_lbl {
  font-family: "Consolas", "Monaco", monospace;
  font-size: 13px;
  color: #476369;
}

/* ============================================
   STATUS BAR
   ============================================ */
QLabel#status_message_lbl {
  font-family: "Consolas", "Monaco", monospace;
  font-size: 11px;
  color: #ffffff;
}
QLabel#status_db_lbl {
  font-size: 10px;
  color: #94b2b8;
}

/* ============================================
   SIDEBAR
   ============================================ */
QFrame#nav_brand {
  border: none;
  background: transparent;
}
QLabel#nav_brand_icon {
  background: transparent;
  border: none;
}
QLabel#nav_brand_name {
  font-family: "Segoe UI", sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #f4f7f6;
  background: transparent;
  border: none;
}
QLabel#nav_status_dot {
  font-size: 13px;
  background: transparent;
  border: none;
  color: #476369;
}
QLabel#nav_status_dot[online="true"] {
  color: #22c55e;
}
QLabel#nav_status_dot[online="false"] {
  color: #476369;
}

QLabel#nav_section {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  color: #94b2b8;
  background: transparent;
  border: none;
}

QPushButton#nav_row {
  background: transparent;
  border: none;
  border-radius: 8px;
  text-align: left;
  padding: 0px;
  min-height: 40px; max-height: 40px;
}
QPushButton#nav_row:hover {
  background-color: rgba(30, 54, 59, 0.5);
}
QPushButton#nav_row[active="true"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 rgba(14, 116, 144, 0.55),
                              stop:1 rgba(6, 182, 212, 0.20));
}
QPushButton#nav_row QLabel#nav_row_text {
  color: #cbdde1;
  font-size: 13px;
  font-weight: 500;
  background: transparent;
  border: none;
}
QPushButton#nav_row:hover QLabel#nav_row_text {
  color: #f4f7f6;
}
QPushButton#nav_row[active="true"] QLabel#nav_row_text {
  color: #FFFFFF;
  font-weight: 600;
}
QFrame#nav_indicator {
  background-color: #22D3EE;
  border-radius: 2px;
}

/* ============================================
   SETUP WIZARD
   ============================================ */
QLabel#setup_title {
  font-size: 32px;
  font-weight: bold;
  color: #0e7490;
}
QLabel#setup_subtitle {
  font-size: 18px;
  color: #1e363b;
}
QLabel#setup_desc {
  color: #64848b;
}
QLabel#setup_header {
  font-size: 14px;
  font-weight: bold;
  color: #64848b;
}
QLabel#setup_label {
  font-size: 11px;
  font-weight: 600;
  color: #476369;
  letter-spacing: 0.5px;
  padding-top: 4px;
}
QLabel#setup_success_icon {
  font-size: 64px;
  color: #059669;
}
QLabel#setup_done_title {
  font-size: 24px;
  font-weight: bold;
  color: #1e363b;
}
QLabel#setup_done_msg {
  color: #64848b;
}
QLabel#setup_test_result {
  font-weight: bold;
  color: #1e363b;
}
QFrame#setup_test_frame {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 8px;
}

/* ============================================
   MODEL PAGE
   ============================================ */
QLabel#model_page_title {
  font-size: 18px;
  font-weight: bold;
  color: #1e363b;
}
QLabel#model_plc_status {
  font-size: 12px;
  color: #64848b;
}
QLabel#model_push_lbl {
  font-size: 11px;
  color: #64848b;
}
QFrame#model_push_bar {
  background-color: #e2eef0;
  border-radius: 4px;
  max-height: 8px;
}

/* ============================================
   MANUAL PAGE
   ============================================ */
QLabel#manual_page_title {
  font-size: 16px;
  font-weight: bold;
  color: #1e363b;
}
QLabel#manual_plc_status {
  font-size: 11px;
  color: #64848b;
}
QLabel#manual_plc_status[status="connected"] {
  color: #16a34a;
}
QLabel#manual_plc_status[status="disconnected"] {
  color: #dc2626;
}
QFrame#manual_ctrl_frame {
  background-color: #ffffff;
  border-radius: 8px;
  border: 1px solid #e2eef0;
}
QLabel#manual_ctrl_label {
  font-size: 12px;
  font-weight: bold;
  color: #0e7490;
}
QLabel#manual_audit_label {
  font-size: 10px;
  color: #d97706;
  font-style: italic;
}
QFrame#manual_live_frame {
  background-color: #ffffff;
  border-radius: 8px;
  border: 1px solid #e2eef0;
}
QLabel#manual_live_label {
  font-size: 12px;
  font-weight: bold;
  color: #0e7490;
}
QScrollArea#manual_scroll {
  background: transparent;
}

/* ============================================
   CONFIG PAGE
   ============================================ */
QLabel#config_info_lbl {
  font-size: 11px;
  color: #64848b;
  font-style: italic;
}
QLabel#config_warn_lbl {
  color: #ca8a04;
}
QLabel#config_error_lbl {
  color: #dc2626;
}
QLabel#config_success_lbl {
  color: #059669;
  font-weight: bold;
}
QFrame#config_warning_banner {
  background-color: rgba(234, 179, 8, 0.08);
  border: 1px solid #ca8a04;
  border-radius: 8px;
  padding: 8px;
}
QLabel#config_msg_curr_lbl {
  font-weight: bold;
  color: #0e7490;
}
QLabel#config_msg_preview {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 6px;
  padding: 12px;
  color: #476369;
  font-size: 13px;
}
QFrame#config_quality_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  padding: 10px;
}
QLabel#config_quality_val {
  font-size: 16px;
  font-weight: bold;
  color: #0e7490;
}
QLabel#config_quality_title {
  font-size: 10px;
  font-weight: 700;
  color: #64848b;
  text-transform: uppercase;
}
QLabel#config_test_pass {
  font-weight: bold;
  color: #059669;
}
QLabel#config_test_fail {
  font-weight: bold;
  color: #dc2626;
}
QLabel#config_status_connected {
  font-weight: bold;
  color: #059669;
}
QLabel#config_status_disconnected {
  font-weight: bold;
  color: #dc2626;
}

/* ============================================
   I/O LIST PAGE
   ============================================ */
QLabel#io_page_title {
  font-size: 14px;
  font-weight: bold;
  color: #0e7490;
}
QLabel#io_last_refresh {
  font-size: 11px;
  color: #64848b;
}
QLabel#io_auto_lbl {
  font-size: 10px;
  color: #059669;
  font-weight: bold;
}
QFrame#io_no_card {
  background-color: #f4f7f6;
  border-radius: 8px;
  border: 1px dashed #cbdde1;
}
QLabel#io_no_msg {
  font-size: 13px;
  color: #64848b;
}
QLabel#io_poll_info {
  font-size: 10px;
  color: #64848b;
}

/* ============================================
   REPORTS PAGE
   ============================================ */
QFrame#reports_filter_card {
  background-color: #f4f7f6;
  border-radius: 8px;
  padding: 8px;
  border: 1px solid #e2eef0;
}
QFrame#reports_detail_card {
  background-color: #f4f7f6;
  border-radius: 8px;
  padding: 10px;
  border: 1px solid #e2eef0;
}
QLabel#reports_detail_placeholder {
  color: #64848b;
}
QLabel#reports_detail_title {
  font-size: 14px;
  font-weight: bold;
  color: #1e363b;
}
QFrame#reports_export_card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 10px;
  border: 1px solid #e2eef0;
}
QLabel#reports_export_status {
  font-size: 10px;
  color: #64848b;
}

/* ============================================
   SETTINGS PAGE
   ============================================ */
QLabel#settings_page_title {
  font-size: 16px;
  font-weight: bold;
  color: #1e363b;
}
QFrame#settings_theme_card {
  border-radius: 8px;
  padding: 10px;
}
QFrame#settings_theme_card[theme="dark"] {
  background-color: #0f2024;
  border: 1px solid #1a3c40;
}
QFrame#settings_theme_card[theme="light"] {
  background-color: #ffffff;
  border: 2px solid #0e7490;
}
QLabel#settings_theme_label {
  font-weight: bold;
}
QLabel#settings_about_lbl {
  color: #1e363b;
}

/* ============================================
   MODULE CARD (signal grid items)
   ============================================ */
QFrame#module_signal_frame {
  background-color: rgba(128,128,128,0.05);
  border-radius: 4px;
}
QLabel#module_signal_name {
  font-size: 11px;
  color: #64848b;
  border: none;
  background: transparent;
}
QLabel#module_signal_value {
  font-size: 14px;
  font-weight: bold;
  font-family: "Consolas", "Monaco", monospace;
  border: none;
  background: transparent;
  color: #1e363b;
}
QLabel#module_signal_value[result="pass"] {
  color: #059669;
}
QLabel#module_signal_value[result="fail"] {
  color: #dc2626;
}
QLabel#module_signal_unit {
  font-size: 9px;
  color: #64848b;
  border: none;
  background: transparent;
}
QLabel#module_mvd_lbl {
  font-size: 11px;
  font-family: "Consolas", "Monaco", monospace;
  color: #0e7490;
  border: none;
  background: transparent;
}
QLabel#module_header_name {
  font-size: 11px;
  font-weight: bold;
  color: #64848b;
  border: none;
  background: transparent;
}
QLabel#module_header_result {
  font-size: 11px;
  font-weight: bold;
  border: none;
  background: transparent;
}

/* ============================================
   MESSAGE BAR
   ============================================ */
QFrame#message_bar {
  background-color: #1a3c40;
}
QLabel#message_bar_current {
  color: #ffffff;
  font-size: 13px;
  background: transparent;
}
QPushButton#message_bar_history_btn {
  background-color: transparent;
  border: none;
  color: #94b2b8;
  font-size: 12px;
  min-width: 28px;
  max-width: 28px;
}
QPushButton#message_bar_history_btn:hover {
  background-color: rgba(255,255,255,0.1);
}

/* ============================================
   COMMENTS DIALOG
   ============================================ */
QListWidget#comments_list {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 4px;
}
QTextEdit#comments_new_comment {
  border: 1px solid #e2eef0;
  border-radius: 4px;
  padding: 8px;
  background-color: #ffffff;
  color: #1e363b;
}
QLabel#comments_char_counter {
  color: #64848b;
  font-size: 11px;
}
QLabel#comments_char_counter[warning="true"] {
  color: #dc2626;
  font-weight: bold;
}

/* ============================================
   REPORTS DIALOG
   ============================================ */
QFrame#reports_dialog_filter {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 4px;
}
QPushButton#reports_dialog_search_btn {
  background-color: #0e7490;
  color: #ffffff;
  font-weight: bold;
  padding: 5px 15px;
}
QPushButton#reports_dialog_search_btn:hover {
  background-color: #155e75;
}
QPushButton#reports_dialog_clear_btn {
  padding: 5px 15px;
}
QLabel#reports_dialog_result_count {
  color: #64848b;
  font-weight: bold;
}
QFrame#reports_dialog_detail {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 4px;
}
QLabel#reports_dialog_placeholder {
  color: #64848b;
  font-style: italic;
}
QLabel#reports_dialog_session_title {
  font-size: 14px;
  font-weight: bold;
  color: #1e363b;
}
QLabel#reports_dialog_alarm {
  color: #d97706;
  font-weight: bold;
}
QLabel#reports_dialog_selected {
  color: #64848b;
}
QPushButton#reports_dialog_excel_btn {
  background-color: #10b981;
  color: #ffffff;
  font-weight: bold;
  padding: 6px 12px;
}
QPushButton#reports_dialog_excel_btn:hover {
  background-color: #059669;
}
QPushButton#reports_dialog_pdf_btn {
  background-color: #ef4444;
  color: #ffffff;
  font-weight: bold;
  padding: 6px 12px;
}
QPushButton#reports_dialog_pdf_btn:hover {
  background-color: #dc2626;
}
QLabel#reports_dialog_progress {
  font-size: 11px;
  color: #476369;
}

/* ============================================
   PASSWORD UTILITY
   ============================================ */
QLabel#password_strength_lbl {
  color: #476369;
  font-weight: 500;
}
QProgressBar#password_strength_bar {
  background-color: #f1f8f9;
  border: 1px solid #e2eef0;
  border-radius: 4px;
  max-height: 10px;
}
QLabel#password_status {
  font-weight: bold;
}
QLabel#password_status[success="true"] {
  color: #059669;
}
QLabel#password_status[success="false"] {
  color: #dc2626;
}

/* ============================================
   PLC CONFIG PANEL
   ============================================ */
QLabel#config_info_banner {
  color: #856404;
  font-style: italic;
  font-size: 12px;
  background: #fff3cd;
  border: 1px solid #ffc107;
  border-radius: 4px;
  padding: 6px 10px;
}
QLabel#config_brand_proto_lbl {
  font-size: 13px;
  color: #1a3c40;
  font-weight: 600;
}
QLabel#config_host_port_lbl {
  font-size: 12px;
  color: #5a828a;
}
QPushButton#btn_primary {
  background-color: #1a3c40;
  color: white;
  min-width: 160px;
  min-height: 42px;
  font-weight: 600;
}
QLabel#config_test_result_lbl {
  font-size: 12px;
}
QLabel#config_test_result_lbl[status="testing"] {
  color: #d4890a;
}
QLabel#config_test_result_lbl[status="pass"] {
  color: #1a6b3a;
  font-weight: 600;
}
QLabel#config_test_result_lbl[status="fail"] {
  color: #c0392b;
  font-weight: 600;
}
QLabel#config_connected_lbl {
  font-weight: 600;
}
QLabel#config_connected_lbl[connected="true"] {
  color: #2ecc71;
}
QLabel#config_connected_lbl[connected="false"] {
  color: #e74c3c;
}

/* ============================================
   PLC BLOCK EDITOR
   ============================================ */
QFrame#block_editor_warning {
  background: #fff3cd;
  border: 1px solid #ffc107;
  border-radius: 4px;
}
QFrame#block_editor_warning QLabel {
  color: #856404;
  background: transparent;
  border: none;
}
QLabel#block_editor_warning_icon {
  font-size: 20px;
}
QLabel#block_editor_warning_text {
  font-size: 12px;
}
QLabel#config_detail_label {
  color: #5a828a;
}
QLabel#config_detail_italic {
  color: #5a828a;
  font-size: 12px;
  font-style: italic;
}
QLabel#config_detail_italic[status="pass"] {
  color: #1a6b3a;
}
QLabel#config_detail_italic[status="fail"] {
  color: #c0392b;
}
QLabel#config_status_lbl {
  font-size: 12px;
  font-weight: 600;
}
QLabel#config_status_lbl[status="pass"] {
  color: #1a6b3a;
}
QLabel#config_status_lbl[status="fail"] {
  color: #c0392b;
}

/* ============================================
   MODEL MANAGER
   ============================================ */
QFrame#card {
  background-color: #f8fbfc;
  border: 1px solid #d0e4e8;
  border-radius: 4px;
}
QFrame#form_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 4px;
}
QLabel#section_title {
  font-weight: bold;
  font-size: 14px;
  color: #1e363b;
}
QTableWidget#model_list_table {
  selection-background-color: #c8e6c9;
  selection-color: black;
}
QLabel#hint_label {
  color: gray;
  font-style: italic;
  font-size: 11px;
}
QLabel#form_section_title {
  font-weight: bold;
  font-size: 14px;
  color: #1a3c40;
}
QFrame#form_divider {
  color: #ecf0f1;
}
QLabel#temp_status {
  color: #2ecc71;
  font-weight: bold;
}

/* ============================================
   MANUAL GRID
   ============================================ */
QPushButton#manual_action_label_btn {
  background: #1a3c40;
  color: #e8f7fa;
  font-weight: bold;
  border: none;
  padding: 5px;
}
QPushButton#manual_action_btn {
  background: #1a3c40;
  color: #e8f7fa;
  border-radius: 2px;
}
QPushButton#manual_action_btn[active="true"] {
  background: #f59e0b;
  color: #e8f7fa;
}

/* ============================================
   ACCESSIBILITY: Focus Indicators
   ============================================ */
QPushButton:focus, QLineEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QTableWidget:focus {
  outline: none;
  border: 2px solid #0e7490;
}
QTabBar::tab:focus {
  outline: 2px solid #0e7490;
  outline-offset: -2px;
}
QProgressBar:focus {
  outline: 2px solid #0e7490;
  outline-offset: 2px;
}

/* ============================================
   ACCESSIBILITY: Minimum touch target sizes
   ============================================ */
QComboBox::drop-down {
  min-width: 30px;
}
QScrollBar::handle:vertical {
  min-height: 30px;
}
QScrollBar::handle:horizontal {
  min-width: 30px;
}

/* ============================================
   PHASE 1: QUICK WINS
   ============================================ */

/* --- Top Bar Quality Dot --- */
QLabel#quality_dot {
  font-size: 10px;
  padding: 0 4px;
}

/* --- Top Bar User Avatar --- */
QLabel#user_avatar {
  background-color: #165663;
  color: white;
  border-radius: 14px;
  font-size: 11px;
  font-weight: bold;
  qproperty-alignment: AlignCenter;
}

/* --- Login Loading State --- */
QLabel#login_loading {
  color: #155e75;
  font-weight: 600;
  padding: 10px;
}
QLabel#login_last_login {
  color: #64848b;
  font-size: 11px;
}

/* --- Test Page Overall Result Card --- */
QFrame#overall_result_card {
  min-height: 100px;
  border-radius: 12px;
  border: 2px solid #e2eef0;
  background-color: #ffffff;
}
QFrame#overall_result_card[status="running"] {
  border-color: #ca8a04;
  background-color: #fefce8;
}
QFrame#overall_result_card[status="pass"] {
  border-color: #16a34a;
  background-color: #f0fdf4;
}
QFrame#overall_result_card[status="fail"] {
  border-color: #dc2626;
  background-color: #fef2f2;
}

/* ============================================
   PHASE 3: DATA VISUALIZATION
   ============================================ */

/* --- Reports Stats Cards --- */
QFrame#reports_stats_frame {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 10px;
}
QFrame#stat_card {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 8px;
}
QLabel#stat_title {
  color: #64848b;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
}
QLabel#stat_value {
  color: #1e363b;
  font-size: 18px;
  font-weight: 700;
  font-family: "Consolas", "Monaco", monospace;
}

/* --- Reports Charts --- */
QFrame#reports_charts_frame {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 10px;
  padding: 8px;
}
QFrame#reports_charts_frame > QFrame {
  background-color: #f4f7f6;
  border: 1px solid #e2eef0;
  border-radius: 8px;
  padding: 8px;
}
QLabel#chart_title {
  color: #64848b;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

/* --- Reports Filter Card --- */
QFrame#reports_filter_card {
  background-color: #ffffff;
  border: 1px solid #e2eef0;
  border-radius: 10px;
  padding: 8px;
}

/* --- Trend Sparkline --- */
QFrame#sparkline_frame {
  background-color: transparent;
  border: none;
}
QLabel#sparkline_label {
  color: #64848b;
  font-size: 9px;
}

/* ============================================
   ENTERPRISE INDUSTRIAL POLISH
   ============================================ */
/* Pill badges for tables (Data Types, Units, Limits) */
QLabel#badge_pill {
  background-color: #f1f8f9;
  color: #64848b;
  border: 1px solid #e2eef0;
  border-radius: 10px;
  padding: 2px 10px;
  font-size: 11px;
  font-weight: 600;
}
QLabel#badge_pill[pill_kind="type"] {
  background-color: rgba(167, 139, 250, 0.15);
  color: #7C3AED;
  border-color: rgba(167, 139, 250, 0.45);
}
QLabel#badge_pill[pill_kind="unit"] {
  background-color: rgba(56, 216, 248, 0.15);
  color: #0e7490;
  border-color: rgba(56, 216, 248, 0.5);
}
QLabel#badge_pill[pill_kind="limit"] {
  background-color: rgba(34, 197, 94, 0.15);
  color: #15803D;
  border-color: rgba(34, 197, 94, 0.4);
}
QLabel#badge_pill[pill_kind="status"] {
  background-color: rgba(34, 197, 94, 0.15);
  color: #15803D;
  border-color: rgba(34, 197, 94, 0.45);
}

/* Refined tables */
QTableWidget, QTableView {
  background-color: #FFFFFF;
  alternate-background-color: #f4f7f6;
  color: #1e363b;
  gridline-color: #e2eef0;
  selection-background-color: rgba(6, 182, 212, 0.18);
  border: 1px solid #e2eef0;
  border-radius: 8px;
  font-size: 12px;
}
QTableWidget::item {
  padding: 5px 8px;
  border: none;
}
QTableWidget::item:hover {
  background-color: rgba(6, 182, 212, 0.08);
}
QHeaderView::section {
  background-color: #f1f8f9;
  color: #64848b;
  border: none;
  border-bottom: 1px solid #e2eef0;
  padding: 8px 10px;
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  min-height: 30px;
}

/* Modern scrollbars */
QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 2px;
}
QScrollBar::handle:vertical {
  background: #cbdde1;
  border-radius: 5px;
  min-height: 30px;
}
QScrollBar::handle:vertical:hover {
  background: #06B6D4;
}
QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 2px;
}
QScrollBar::handle:horizontal {
  background: #cbdde1;
  border-radius: 5px;
  min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
  background: #06B6D4;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0px; width: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}

/* Status LED dots (I/O page) */
QLabel#led_dot {
  background-color: #cbdde1;
  border-radius: 6px;
  min-width: 10px; max-width: 10px;
  min-height: 10px; max-height: 10px;
}
QLabel#led_dot[state="high"] {
  background-color: #22c55e;
  border: 1px solid rgba(34, 197, 94, 0.8);
}
QLabel#led_dot[state="low"] {
  background-color: #cbdde1;
}

QFrame#led_cell {
  background: transparent;
  border: none;
}
QLabel#led_label {
  color: #64848b;
  font-size: 11px;
  background: transparent;
  border: none;
}

/* Connection status pill (top bar) */
QFrame#plc_status_pill {
  background-color: #f1f8f9;
  border: 1px solid #e2eef0;
  border-radius: 14px;
}
QFrame#plc_status_pill[online="true"] {
  border-color: rgba(34, 197, 94, 0.5);
  background-color: rgba(34, 197, 94, 0.12);
}
QFrame#plc_status_pill QLabel {
  color: #64848b;
  font-size: 11px;
  font-weight: 600;
}
QFrame#plc_status_pill[online="true"] QLabel {
  color: #15803D;
}
QLabel#plc_status_dot {
  font-size: 12px;
}
QFrame#plc_status_pill[online="true"] QLabel#plc_status_dot {
  color: #22c55e;
}

/* ============================================ PHASE 1 PARITY (ported from dark.qss) ============================================ */
QLabel#quality_dot[quality="good"] {
  color: #16a34a;
}
QLabel#quality_dot[quality="medium"] {
  color: #d97706;
}
QLabel#quality_dot[quality="poor"] {
  color: #dc2626;
}

QLabel#stat_value[rate_level="high"] {
  color: #16a34a;
}
QLabel#stat_value[rate_level="medium"] {
  color: #d97706;
}
QLabel#stat_value[rate_level="low"] {
  color: #dc2626;
}

QLabel#confirm_dialog_message {
  color: #1e363b;
  font-size: 14px;
}

QLabel#editor_title {
  font-size: 13px;
  font-weight: bold;
  color: #0e7490;
}

QLabel#status_lbl[status="success"] {
  color: #15803d;
  font-size: 11px;
  font-weight: 600;
}
QLabel#status_lbl[status="error"] {
  color: #dc2626;
  font-size: 11px;
  font-weight: 600;
}

ToastNotification {
  background-color: #ffffff;
  border-radius: 6px;
}

SkeletonBar {
  background-color: transparent;
}

Spinner {
  background-color: transparent;
}

