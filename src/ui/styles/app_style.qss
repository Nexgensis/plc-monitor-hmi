/* Complete Qt stylesheet. All widget types covered. */

QMainWindow, QDialog, QWidget {
  background-color: #f0f2f5;
  font-family: "Segoe UI", sans-serif;
  font-size: 13px;
  color: #1a1a2e;
}

QPushButton {
  background: #1e2d4a;
  color: white;
  border: none;
  border-radius: 4px;
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 500;
  min-height: 36px;
}

QPushButton:hover {
  background: #243657;
}

QPushButton:pressed {
  background: #162238;
}

QPushButton:disabled {
  background: #b0b8c8;
  color: #7a8090;
}

QPushButton#btn_danger {
  background: #c0392b;
}

QPushButton#btn_danger:hover {
  background: #e74c3c;
}

QPushButton#btn_success {
  background: #1a6b3a;
}

QPushButton#btn_success:hover {
  background: #218f4e;
}

QPushButton#btn_secondary {
  background: #6c757d;
}

QPushButton#btn_secondary:hover {
  background: #5a6268;
}

QPushButton#btn_warning {
  background: #d4890a;
}

QPushButton#btn_warning:hover {
  background: #e89c12;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background: white;
  border: 1.5px solid #c0c8d8;
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 13px;
  min-height: 34px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
  border-color: #1e2d4a;
}

QTableWidget {
  background: white;
  alternate-background-color: #f8f9fc;
  gridline-color: #d8dde8;
  selection-background-color: #d0ddf0;
}

QHeaderView::section {
  background-color: #1e2d4a;
  color: white;
  height: 36px;
  border: none;
  font-weight: 500;
}

QGroupBox {
  border: 1.5px solid #c0c8d8;
  border-radius: 6px;
  margin-top: 8px;
  padding-top: 8px;
}

QGroupBox::title {
  color: #1e2d4a;
  font-weight: 500;
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 3px 0 3px;
}

QTabWidget::pane {
  border: 1px solid #c0c8d8;
  border-radius: 4px;
}

QTabBar::tab {
  background: #e0e8f0;
  padding: 8px 20px;
  border-radius: 4px 4px 0 0;
}

QTabBar::tab:selected {
  background: white;
  border-bottom: none;
  font-weight: 500;
}

QLabel#lbl_pass {
  background: #1a6b3a;
  color: white;
  border-radius: 4px;
  padding: 3px 10px;
}

QLabel#lbl_fail {
  background: #c0392b;
  color: white;
  border-radius: 4px;
  padding: 3px 10px;
}

QLabel#lbl_pending {
  background: #6c757d;
  color: white;
  border-radius: 4px;
  padding: 3px 10px;
}

QLabel#lbl_running {
  background: #d4890a;
  color: white;
  border-radius: 4px;
  padding: 3px 10px;
}

QLabel#plc_ok {
  background: #1a6b3a;
  color: white;
  padding: 4px 12px;
}

QLabel#plc_err {
  background: #c0392b;
  color: white;
  padding: 4px 12px;
}

QFrame#card {
  background: white;
  border: 1px solid #d0d8e8;
  border-radius: 8px;
}

QFrame#status_bar_frame {
  background: #1e2d4a;
  min-height: 32px;
}

QFrame#push_status_ok {
  background: #e8f5ee;
  border: 1px solid #a0d0b0;
  border-radius: 4px;
}

QFrame#push_status_fail {
  background: #fdeaea;
  border: 1px solid #e0a0a0;
  border-radius: 4px;
}

QFrame#push_status_pending {
  background: #fdf3e0;
  border: 1px solid #e0c880;
  border-radius: 4px;
}

QProgressBar {
  background: #e0e8f0;
  border-radius: 4px;
  height: 8px;
  text-align: center;
}

QProgressBar::chunk {
  background: #1e2d4a;
  border-radius: 4px;
}

QScrollBar:vertical {
  width: 8px;
  background: transparent;
}

QScrollBar::handle:vertical {
  background: rgba(30, 45, 74, 0.5); /* #1e2d4a at 50% opacity */
  border-radius: 4px;
}

QScrollBar:horizontal {
  height: 8px;
  background: transparent;
}

QScrollBar::handle:horizontal {
  background: rgba(30, 45, 74, 0.5);
  border-radius: 4px;
}

QSplitter::handle {
  background: #d0d8e8;
  width: 2px;
}
